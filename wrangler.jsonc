{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finance-repo",
  "workers_dev": true,
  "preview_urls": true,
  "account_id": "32d0e852b83ed6fc374b1c53d97b5729",
  "main": "backend/dist/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "vars": {
    "APP_ENVIRONMENT": "test",
    "INFRASTRUCTURE_PROBE_ENABLED": "false"
  },
  // Nest imports these optional packages even in an HTTP-only app. Keep their
  // normal missing-package behavior without requiring unused feature stacks.
  // Install the real package and remove its alias before enabling that feature.
  "alias": {
    "class-validator": "./backend/cloudflare/missing-optional-package.mjs",
    "class-transformer": "./backend/cloudflare/missing-optional-package.mjs",
    "@nestjs/microservices": "./backend/cloudflare/missing-optional-package.mjs",
    "@nestjs/microservices/microservices-module.js": "./backend/cloudflare/missing-optional-package.mjs",
    "@nestjs/websockets/socket-module.js": "./backend/cloudflare/missing-optional-package.mjs"
  },
  "assets": {
    "directory": "frontend/dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-finance-test",
      "database_id": "f0855884-2cee-4d5a-8e35-33fb360d441c",
      "migrations_dir": "backend/migrations"
    }
  ],
  // Previews use a separate D1 database; bindings are not isolated automatically.
  "previews": {
    "vars": {
      "APP_ENVIRONMENT": "preview",
      "INFRASTRUCTURE_PROBE_ENABLED": "false"
    },
    "d1_databases": [{
      "binding": "DB",
      "database_name": "family-finance-preview",
      "database_id": "76e93026-a7e8-40f1-ac66-b0dc5c65b2cf"
    }]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  },
  "env": {
    "local": {
      "name": "finance-repo-local",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENVIRONMENT": "local",
        "INFRASTRUCTURE_PROBE_ENABLED": "true"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "finance-repo-local",
        // Simulator identifier only; not a Cloudflare database UUID.
        "database_id": "00000000-0000-4000-8000-000000000003",
        "migrations_dir": "backend/migrations",
        "remote": false
      }]
    },
    "test": {
      "name": "finance-repo-test",
      "vars": {
        "APP_ENVIRONMENT": "test",
        "INFRASTRUCTURE_PROBE_ENABLED": "false"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "family-finance-test",
        "database_id": "f0855884-2cee-4d5a-8e35-33fb360d441c",
        "migrations_dir": "backend/migrations",
        "remote": false
      }]
    },
    "production": {
      "name": "finance-repo-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENVIRONMENT": "production",
        "INFRASTRUCTURE_PROBE_ENABLED": "false"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "family-finance-production",
        // Unconfigured on purpose. Supply a real, separate production DB UUID
        // after the production-environment decision; never reuse the test ID.
        "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
        "migrations_dir": "backend/migrations",
        "remote": false
      }]
    }
  }
}
